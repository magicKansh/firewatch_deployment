# Firewatch Pi node settings. Installed to /etc/firewatch/node.env.
# After editing:  sudo systemctl restart firewatch-node

FIREWATCH_SERVER_URL=https://your-service.onrender.com

# --- Detection -----------------------------------------------------------------
# A pixel is "hot" when it is >= HOT_TEMP_C AND >= background + AMBIENT_DELTA_C.
HOT_TEMP_C=80
AMBIENT_DELTA_C=25
# Smallest connected hot cluster (MLX90640 is 32x24 = 768 pixels).
MIN_CLUSTER_PIXELS=6
# Minimum share of the frame that must be hot. 0.5% is about 4 pixels.
MIN_HOT_PERCENT=0.5
# Consecutive hot frames before an alert (at 4 Hz, 5 frames is ~1.5 s).
REQUIRED_FRAMES=5
# Quiet frames before a new, separate event can be raised.
QUIET_FRAMES_TO_RESET=30
# While heat persists, send an updated image this often (seconds; 0 = never).
EVENT_UPDATE_SECONDS=300

# --- Sensor --------------------------------------------------------------------
# 1, 2, 4 or 8. 4 Hz is reliable with the 1 MHz I2C bus set by install.sh.
THERMAL_REFRESH_HZ=4
# Mirror the image if it looks flipped compared with the real scene.
THERMAL_FLIP_H=0
THERMAL_FLIP_V=0

# --- Snapshots (RAM only, oldest deleted automatically) ------------------------
SNAPSHOT_SECONDS=60
SNAPSHOT_KEEP=5
# How many of the most recent snapshots to attach to an alert as "before" images.
CONTEXT_SNAPSHOTS=2

# --- Optional Pi Camera (visible light) ----------------------------------------
# auto = use it if one is connected, off = thermal only, on = fail if missing
FIREWATCH_PICAMERA=auto
