PUBLIC_BASE_URL=https://your-firewatch-domain.example
FIREWATCH_DB=/absolute/path/to/data/firewatch.db
FIREWATCH_ADMIN_TOKEN=replace_with_a_long_random_admin_token
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=31457280
EVENT_DEDUPE_SECONDS=600
CONFIRMATION_TOKEN_TTL_HOURS=24
HEARTBEAT_TIMEOUT_SECONDS=90

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=+15555550123

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=replace_me
FROM_EMAIL=alerts@example.com

FIRMS_API_KEY=replace_me
# Optional custom monitored area: west,south,east,north
# FIRMS_BBOX=-75.0,39.0,-73.0,42.0
ORS_API_KEY=replace_me

# Raspberry Pi node tuning
HOT_TEMP_C=80
MIN_HOT_PERCENT=0.5
MIN_CLUSTER_PIXELS=6
AMBIENT_DELTA_C=25
REQUIRED_FRAMES=5
VISUAL_REQUIRED_FRAMES=4
VISUAL_FIRE_THRESHOLD=0.015
VISUAL_SAMPLE_SECONDS=0.5
FIREWATCH_CLIP_SECONDS=6
HEARTBEAT_SECONDS=30
FIREWATCH_SERVER_URL=https://your-firewatch-domain.example

# Review flow (server)
# Send the heat image inside the text message (needs an https PUBLIC_BASE_URL; falls back to SMS).
TWILIO_SEND_MMS=1
# After "not a fire", the same hotspot is logged quietly instead of re-alerting:
FALSE_ALARM_COOLDOWN_SECONDS=3600
FALSE_ALARM_RADIUS_PX=3
FALSE_ALARM_TEMP_MARGIN_C=15
